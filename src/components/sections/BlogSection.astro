---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../../utils/format";

interface Props {
  posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
---

<section class="page" id="blog" data-scrollspy-section aria-labelledby="blog-title">
  <div class="wrap">
    <header class="section-head">
      <p class="section-kicker">From the lab</p>
      <h2 id="blog-title">Blog</h2>
      <p>Notes from lab members on projects, papers and what we learn along the way.</p>
    </header>
    <div class="posts">
      {posts.map((post) => {
        const { data } = post;
        const href = post.body?.trim() ? `/blog/${post.id}/` : null;
        return (
          <article class:list={["post", { "has-cover": data.cover }]}>
            {data.cover && href && (
              <a class="post-cover" href={href} tabindex="-1" aria-hidden="true">
                <img src={data.cover.srcSmall ?? data.cover.src} width="800" height={Math.round(800 * data.cover.height / data.cover.width)} alt="" loading="lazy" decoding="async" />
              </a>
            )}
            <time datetime={data.date.toISOString().slice(0, 10)}>{formatDate(data.date)}</time>
            <h3>{href ? <a href={href}>{data.title}</a> : data.title}</h3>
            <p>{data.excerpt}</p>
            {href && <a class="text-link" href={href}>Read post</a>}
          </article>
        );
      })}
    </div>
  </div>
</section>
