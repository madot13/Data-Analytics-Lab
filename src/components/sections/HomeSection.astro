---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../../utils/format";

interface Props {
  news: CollectionEntry<"news">[];
}

const { news } = Astro.props;
const latestNews = news.filter(({ data }) => data.category === "lab").slice(0, 3);

const heroPhotos = [
  { file: "team-freedom", caption: "MADRID Lab team at Freedom Holding Corp.", alt: "MADRID Lab members posing in front of the Freedom Holding Corp. sign" },
  { file: "hero-team", caption: "MADRID Lab team", alt: "MADRID Lab members gathered with certificates at SDU University" },
  { file: "team-certificates", caption: "Certificate day at SDU University", alt: "MADRID Lab members standing in a row outdoors holding certificates" },
  { file: "team-nauryz", caption: "Nauryz celebration", alt: "MADRID Lab members in matching T-shirts at a Nauryz celebration" },
];
---

<section class="page home-page" id="home" data-scrollspy-section>
  <div class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <p class="eyebrow">SDU University research laboratory</p>
          <h1>We turn data into decisions.</h1>
          <p class="lead">
            MADRID Lab is a university research group working on machine learning,
            analytics and data research, with one goal: methods that help people
            make better, well-grounded decisions.
          </p>
          <div class="actions">
            <a class="btn btn-primary" href="#research">Explore our research</a>
            <a class="btn btn-ghost" href="#members">Meet the team</a>
          </div>
        </div>
        <ol class="acronym" aria-label="What MADRID stands for">
          <li><span class="ini">M</span><span class="rest">achine learning</span></li>
          <li><span class="ini">A</span><span class="rest">nalytics</span></li>
          <li><span class="ini">D</span><span class="rest">ata</span></li>
          <li><span class="ini">R</span><span class="rest">esearch</span></li>
          <li><span class="ini">I</span><span class="rest">ntelligent</span></li>
          <li><span class="ini">D</span><span class="rest">ecisions</span></li>
        </ol>
      </div>

      <figure class="hero-photo" data-hero-gallery aria-roledescription="carousel" aria-label="MADRID Lab photos">
        <div class="hero-slides">
          {heroPhotos.map((photo, index) => (
            <img
              class:list={["hero-slide", { "is-active": index === 0 }]}
              src={`/images/${photo.file}-1920.webp`}
              srcset={`/images/${photo.file}-960.webp 960w, /images/${photo.file}-1920.webp 1920w`}
              sizes="(max-width: 720px) calc(100vw - 40px), (max-width: 1180px) calc(100vw - 56px), 1124px"
              width="1920"
              height="1080"
              alt={photo.alt}
              decoding="async"
              loading={index === 0 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : "auto"}
              aria-hidden={index === 0 ? undefined : "true"}
              data-caption={photo.caption}
            />
          ))}
          <button class="hero-nav hero-prev" type="button" aria-label="Previous photo" hidden>
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <button class="hero-nav hero-next" type="button" aria-label="Next photo" hidden>
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
        </div>
        <figcaption>
          <span data-hero-caption aria-live="polite">{heroPhotos[0].caption}</span>
          <span class="hero-dots" hidden>
            {heroPhotos.map((photo, index) => (
              <button type="button" aria-label={`Show photo ${index + 1}: ${photo.caption}`} aria-current={index === 0 ? "true" : undefined} />
            ))}
          </span>
        </figcaption>
      </figure>
    </div>
  </div>

  <div class="content-section about">
    <div class="wrap">
      <div class="about-grid">
        <h2 class="h2">About the lab</h2>
        <div class="body-copy">
          <p>
            We bring together students and researchers who want to work on real
            data problems: building models, testing them honestly, and
            understanding when their results can be trusted.
          </p>
          <p class="muted">
            Our work spans four connected areas, from learning algorithms to the
            decisions they support. Students join us for research projects,
            theses and internships.
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="content-section highlight-section">
    <div class="wrap">
      <article class="highlight">
        <figure class="highlight-photo">
          <img
            src="/images/digital-bridge-2026-1280.webp"
            srcset="/images/digital-bridge-2026-640.webp 640w, /images/digital-bridge-2026-1280.webp 1280w"
            sizes="(max-width: 1040px) calc(100vw - 40px), 560px"
            width="1280"
            height="853"
            alt="Panel session on the main stage of AI & Digital Bridge 2026 in Astana"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="highlight-copy">
          <p class="highlight-kicker">Highlight · October 2026</p>
          <h2>Through to the next stage at AI&nbsp;&amp;&nbsp;Digital Bridge</h2>
          <p>
            At AI &amp; Digital Bridge 2026 in Astana, lab members Aisulu, Aknur
            and Abilmansur presented and defended their team's project. The team
            advanced to the second qualification stage of the GovTech programme
            organised by the Ministry of Education.
          </p>
          <ul class="highlight-people" aria-label="Lab members on the team">
            <li>Aisulu Igimbayeva</li>
            <li>Aknur Mansurkhan</li>
            <li>Abilmansur Alibekov</li>
          </ul>
        </div>
      </article>
    </div>
  </div>

  {latestNews.length > 0 && (
    <div class="content-section">
      <div class="wrap">
        <div class="row-head">
          <h2 class="h2">Latest news</h2>
          <a class="text-link" href="#news">All news</a>
        </div>
        <ul class="news-list">
          {latestNews.map(({ data }) => (
            <li class="news-item">
              <time datetime={data.date.toISOString().slice(0, 10)}>{formatDate(data.date)}</time>
              <div><h3>{data.title}</h3><p>{data.text}</p></div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  )}

  <div class="content-section join-band">
    <div class="wrap join">
      <div>
        <h2>Want to do research with us?</h2>
        <p>
          We regularly take on students for research projects and theses. See
          what is open right now.
        </p>
      </div>
      <a class="btn btn-primary" href="#openings">See openings</a>
    </div>
  </div>
</section>
